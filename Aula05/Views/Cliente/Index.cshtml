@using Aula05.Models.Cliente

@model List<ClienteModel>

<h2>Lista de Clientes</h2>

<a class="btn btn-success" style="margin-bottom:5px" asp-action="Criar">Novo Cliente</a>

<table class="table table-striped">
    <thead class="table-dark">
        <tr>
            <th>Nome</th>
            <th>E-mail</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (ClienteModel cliente in Model)
        {
            <tr>
                <td>@cliente.Nome</td>
                <td>@cliente.Email</td>
                <td>
                    <a class="btn btn-info" asp-action="Editar" asp-route-id="@cliente.Id">Editar</a>
                    <a class="btn btn-danger" asp-action="Excluir" asp-route-id="@cliente.Id">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>