@using Aula05.Models.Cliente

@model ClienteModel

<h2>Criar Cliente</h2>

<form asp-action="Criar" method="post">
    <div>
        <label>Nome:</label>
        <input asp-for="Nome" />
    </div>
    <div style="padding-top:10px">
        <label>E-mail:</label>
        <input asp-for="Email" />
    </div>
    <div style="padding-top:10px">
        <button class="btn btn-primary" type="submit">Salvar</button>
        <a class="btn btn-secondary" asp-action="Index">Voltar</a>
    </div>
</form>