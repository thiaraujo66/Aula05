@using Aula05.Models.Cliente

@model ClienteModel

<h2 class="text-danger"> Confirmar Exclusão</h2>
<hr/>
<div>
    <p>Você tem certeza que deseja excluir o Cliente <strong>@Model.Nome</strong>?</p>
    <dl class="row">
        <dt class="col-sm-2">E-mail:</dt>
        <dd class="col-sm-10">@Model.Email</dd>
    </dl>

    <form asp-action="ExcluirConfirmado" method="post">
        <input type="hidden" asp-for="Id" />
        <button class="btn btn-danger" type="submit">⚠️ Sim, Excluir</button>
        <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
    </form>
</div>